# Matikan daftar isi folder di browser bila tidak ada file index (aman untuk shared hosting)
# Options -Indexes diabaikan/dihapus karena sering memicu 403 Forbidden di hosting gratis

# Lindungi file sensitif / berkas database dari unduhan langsung via browser
<FilesMatch "\.(sql|env|git|log|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Prioritas halaman utama
DirectoryIndex index.html index.php
