# Lindungi file konfigurasi, instalasi, dan skema database dari unduhan publik
<FilesMatch "^(config\.php|install\.php|schema\.sql|\.htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
